---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { getAllWork, mediaUrl } from '../lib/payload';

const items = (await getAllWork()).map(work => ({
  slug: work.slug,
  title: work.title,
  thumbnail: { url: mediaUrl(work.thumbnail), alt: work.thumbnail.alt },
}));
---

<BaseLayout title="Home">
  <SiteHeader />
  <section class="work">
    <h2 class="section-label">Work</h2>
    <WorkGrid items={items} />
  </section>
</BaseLayout>

<style>
  .work {
    margin-top: var(--gap-xl);
    display: grid;
    gap: var(--gap-sm);
  }
</style>
