---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WorkGrid from '../components/WorkGrid.astro';
import HeroCanvas from '../components/HeroCanvas.tsx';
import { getAllWork, mediaUrl } from '../lib/payload';

const items = (await getAllWork()).map(work => ({
  slug: work.slug,
  title: work.title,
  thumbnail: { url: mediaUrl(work.thumbnail), alt: work.thumbnail.alt },
}));
---

<BaseLayout title="Home">
  <div class="hero-bg" aria-hidden="true">
    <HeroCanvas client:only="react" />
  </div>
  <SiteHeader />
  <section class="work">
    <h2 class="section-label">Work</h2>
    <WorkGrid items={items} />
  </section>
</BaseLayout>

<style>
  .hero-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .work {
    margin-top: var(--gap-xl);
    display: grid;
    gap: var(--gap-sm);
  }
</style>
