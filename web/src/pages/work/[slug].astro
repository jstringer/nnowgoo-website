---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { getAllWork, isVideo, mediaUrl, type Work } from '../../lib/payload';

export async function getStaticPaths() {
  const all = await getAllWork();
  return all.map(work => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props as { work: Work };

// Stored as a full ISO date; the CMS only picks a month, so format in UTC.
const dateLabel = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(work.date));

const tags = (work.stack ?? []).map(t => t.name);
const gallery = (work.gallery ?? []).map(g => g.image);
const lastIsOdd = gallery.length % 2 === 1;
---

<BaseLayout title={work.title} description={work.overview}>
  <a href="/" class="back">&lt; back</a>

  <header class="head">
    <div>
      <h1 class="title">{work.title}</h1>
      <p class="client muted">{work.client}</p>
    </div>
    <p class="date muted">{dateLabel}</p>
  </header>

  <div class="meta">
    <section>
      <h2 class="label">Overview</h2>
      <p>{work.overview}</p>
    </section>
    <section>
      <h2 class="label">Stack</h2>
      <TagList tags={tags} />
    </section>
  </div>

  <div class="gallery">
    {gallery.map((item, i) => {
      const full = lastIsOdd && i === gallery.length - 1;
      return (
        <div class:list={['gallery__item', { full }]}>
          {isVideo(item) ? (
            <video
              src={`${mediaUrl(item)}#t=0.001`}
              aria-label={item.alt}
              controls
              playsinline
              preload="metadata"
            />
          ) : (
            <Image
              src={mediaUrl(item)}
              alt={item.alt}
              inferSize
              widths={[400, 800, 1200, 1600]}
              sizes="(min-width: 720px) 50vw, 100vw"
              loading="lazy"
            />
          )}
        </div>
      );
    })}
  </div>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: var(--gap-lg);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--gap-md);
  }

  .title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .client {
    font-size: 1.25rem;
    text-transform: uppercase;
  }

  .date {
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-lg);
    margin: var(--gap-lg) 0;
  }

  .label {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .meta p {
    font-size: 0.875rem;
    max-width: 60ch;
  }

  .gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gap);
  }

  .gallery__item {
    background: #5e5e5e;
  }

  .gallery__item.full {
    grid-column: 1 / -1;
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Letterbox instead of cropping so portrait and landscape clips stay whole
     and the controls are never cut off. */
  .gallery__item video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--bg);
  }

  @media (max-width: 720px) {
    .meta,
    .gallery {
      grid-template-columns: 1fr;
    }

    .gallery__item.full {
      grid-column: auto;
    }
  }
</style>
