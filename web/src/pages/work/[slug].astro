---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import WorkMedia from '../../components/WorkMedia.astro';
import { getAllWork, type Work } from '../../lib/payload';

export async function getStaticPaths() {
  const all = await getAllWork();
  return all.map(work => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props as { work: Work };

// Stored as a full ISO date; the CMS only picks a month, so format in UTC.
const dateLabel = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(work.date));

const tags = (work.stack ?? []).map(t => t.name);

// Rows with neither text nor media are skipped.
const rows = (work.rows ?? [])
  .map(r => ({
    text: r.text?.trim() || null,
    side: r.textSide === 'right' ? 'right' : 'left',
    media: r.media ?? [],
  }))
  .filter(r => r.text || r.media.length > 0);

// Legacy gallery, rendered below the rows until it's moved into Rows.
const gallery = (work.gallery ?? []).map(g => ({
  item: g.image,
  full: g.layout === 'full',
}));

const description = (work.overview || rows.find(r => r.text)?.text || '').slice(0, 200);
---

<BaseLayout title={work.title} description={description}>
  <a href="/" class="back">&lt; back</a>

  <header class="head">
    <div>
      <h1 class="title">{work.title}</h1>
      <p class="client muted">{work.client}</p>
    </div>
    <p class="date muted">{dateLabel}</p>
  </header>

  <div class="meta">
    {work.overview && (
      <section>
        <h2 class="label">Overview</h2>
        <p class="text">{work.overview}</p>
      </section>
    )}
    <section>
      <h2 class="label">Stack</h2>
      <TagList tags={tags} />
    </section>
  </div>

  <div class="rows">
    {rows.map(row => {
      const both = row.text && row.media.length > 0;
      const mediaOnly = !row.text;
      const cols = Math.max(row.media.length, 1);
      const sizes = mediaOnly
        ? `(min-width: 720px) ${Math.round(100 / cols)}vw, 100vw`
        : '(min-width: 720px) 50vw, 100vw';
      return (
        <div
          class:list={['row', { 'row--media': mediaOnly }]}
          style={mediaOnly ? `--cols: ${cols}` : undefined}
        >
          {row.text && (
            <p class:list={['text', 'row__text', `row__text--${row.side}`]}>{row.text}</p>
          )}
          {row.media.length > 0 && (
            <div class:list={['row__media', { 'row__media--split': mediaOnly }]}>
              {row.media.map(item => (
                <div class="media">
                  <WorkMedia item={item} sizes={sizes} />
                </div>
              ))}
            </div>
          )}
        </div>
      );
    })}
  </div>

  {gallery.length > 0 && (
    <div class="gallery">
      {gallery.map(({ item, full }) => (
        <div class:list={['gallery__item', { full }]}>
          <WorkMedia item={item} sizes={full ? '100vw' : '(min-width: 720px) 50vw, 100vw'} />
        </div>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: var(--gap-lg);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--gap-md);
  }

  .title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .client {
    font-size: 1.25rem;
    text-transform: uppercase;
  }

  .date {
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-lg);
    margin: var(--gap-lg) 0;
  }

  .label {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Text fields are plain textareas: keep their line and paragraph breaks. */
  .text {
    font-size: 0.875rem;
    max-width: 60ch;
    white-space: pre-wrap;
  }

  .rows {
    display: grid;
    gap: var(--gap-lg) var(--grid-gap);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gap);
    align-items: start;
  }

  /* Text sits in its half; media takes the other. Text-only rows leave the
     other half empty. */
  @media (min-width: 721px) {
    .row__text--left,
    .row__text--right ~ .row__media {
      grid-column: 1;
    }

    .row__text--right,
    .row__text--left ~ .row__media {
      grid-column: 2;
    }
  }

  .row__media {
    display: grid;
    gap: var(--grid-gap);
  }

  /* No text: media items share the full width. */
  .row--media {
    grid-template-columns: 1fr;
  }

  .row__media--split {
    grid-column: 1 / -1;
    grid-template-columns: repeat(var(--cols), 1fr);
  }

  .media {
    background: #5e5e5e;
  }

  .gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gap);
    margin-top: var(--gap-lg);
  }

  .gallery__item {
    background: #5e5e5e;
  }

  .gallery__item.full {
    grid-column: 1 / -1;
  }

  @media (max-width: 720px) {
    .meta,
    .row,
    .gallery {
      grid-template-columns: 1fr;
    }

    .row__media--split {
      grid-template-columns: 1fr;
    }

    .gallery__item.full {
      grid-column: auto;
    }
  }
</style>
