---
// Home-only header row. Layout per styleframe: name (left) | HeroCanvas circle
// (middle) | nav (right), with the tagline below the row.
import HeroCanvas from './HeroCanvas.tsx';

interface Props {
  name?: string;
  tagline?: string;
}

const {
  name = 'Jack Stringer',
  tagline = 'Creative Technologist, Software Engineer, and Technical Director for live events and interactive & immersive entertainment',
} = Astro.props;

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/resume.pdf', label: 'Resume', external: true },
  { href: 'mailto:hello@example.com', label: 'Contact' },
];
---

<header class="site-header">
  <div class="site-header__row">
    <h1 class="site-header__name">{name}</h1>
    <div class="site-header__orb" aria-hidden="true">
      <HeroCanvas client:only="react" />
    </div>
    <nav class="site-header__nav" aria-label="Primary">
      {navLinks.map(link => (
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
  <p class="site-header__tagline">{tagline}</p>
</header>

<style>
  .site-header__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--gap-md);
  }

  .site-header__name {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .site-header__orb {
    position: relative;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .site-header__nav {
    display: flex;
    justify-content: flex-end;
    gap: var(--gap-sm);
    font-size: 0.95rem;
  }

  .site-header__tagline {
    margin-top: var(--gap-md);
    max-width: 35ch;
    font-size: 1.125rem;
  }

  @media (max-width: 720px) {
    .site-header__row {
      grid-template-columns: 1fr auto;
    }

    .site-header__name {
      grid-column: 1 / -1;
    }

    .site-header__nav {
      justify-content: flex-start;
    }
  }
</style>
