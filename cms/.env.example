# Postgres (Neon pooled connection string; use the `dev` branch locally)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Origin of the Astro site (CORS/CSRF allowlist)
WEB_URL=http://localhost:4321

# Vercel Deploy Hook URL for the web project (leave empty locally)
WEB_DEPLOY_HOOK_URL=

# Vercel Blob token for media storage (leave empty locally to use disk)
BLOB_READ_WRITE_TOKEN=
