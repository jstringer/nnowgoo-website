# Postgres (Neon pooled connection string; use the `dev` branch locally)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Origin of the Astro site (CORS/CSRF allowlist)
WEB_URL=http://localhost:4321

# Vercel Deploy Hook URL for the web project (leave empty locally)
WEB_DEPLOY_HOOK_URL=

# Neon Object Storage (S3-compatible), per branch. Leave empty to store media on
# local disk (cms/media/). Bucket must be public_read.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Public origin of this CMS (CSRF allowlist for the admin UI), e.g. https://cms.example.com
CMS_URL=http://localhost:3000
